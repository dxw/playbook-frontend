# Outline
# https://dxw.getoutline.com/settings/api-keys
# Required scopes: documents.info documents.search attachments.redirect collections.info collections.documents
OUTLINE_API_KEY = 
OUTLINE_COLLECTION_ID = 

# Server Configuration
PORT = 4567
RACK_ENV = 'production' or 'development'

# Cache Configuration
# REDIS_URL=redis://localhost:6379/0
# DISABLE_REDIS_CACHE=false

# Rollbar
# Get your access token from https://rollbar.com/
ROLLBAR_ACCESS_TOKEN=

# SAML Configuration
# Match the Entity ID configured in Google's Service provider details.
SAML_SP_ENTITY_ID=https://playbook.dxw.com/auth/saml/metadata
SAML_IDP_ENTITY_ID=
# Obtain the SSO URL and certificate from Google IdP information.
SAML_IDP_SSO_SERVICE_URL=
# Store line breaks as \n when providing the certificate on one line.
SAML_IDP_CERT=
# Configure this assertion consumer service URL with the identity provider.
SAML_ASSERTION_CONSUMER_SERVICE_URL=https://playbook.dxw.com/auth/saml/callback

# Session secret
# Must be at least 64 characters long
SESSION_SECRET=