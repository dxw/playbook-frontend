# Outline
# https://dxw.getoutline.com/settings/api-keys
# Required scopes: documents.info documents.search attachments.redirect collections.info collections.documents
OUTLINE_API_KEY = 
OUTLINE_COLLECTION_ID = 

# Server Configuration
PORT = 4567
RACK_ENV = 'production' or 'development'

# Cache Configuration
# REDIS_URL=redis://localhost:6379/0
# DISABLE_REDIS_CACHE=false

# Rollbar
# Get your access token from https://rollbar.com/
ROLLBAR_ACCESS_TOKEN=

# SAML
# Obtain these values from the identity provider's SAML metadata.
SAML_SP_ENTITY_ID=
SAML_IDP_SSO_SERVICE_URL=
# Store line breaks as \n when providing the certificate on one line.
SAML_IDP_CERT=
# Configure this assertion consumer service URL with the identity provider.
SAML_ASSERTION_CONSUMER_SERVICE_URL=https://your-host/auth/saml/callback

# Session
# Use a long, random value in production
SESSION_SECRET=